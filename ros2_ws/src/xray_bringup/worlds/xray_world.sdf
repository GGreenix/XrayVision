<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="xray_world">
    <gravity>0 0 -9.8</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.75 0.8 0.9 1.0</background>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1.0 1.0 1.0 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.34 0.28 1</ambient>
            <diffuse>0.36 0.42 0.36 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="landing_pad">
      <static>true</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_collision">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="pad_visual">
          <geometry>
            <cylinder>
              <radius>2.0</radius>
              <length>0.04</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.55 0.12 1</ambient>
            <diffuse>0.9 0.6 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="vehicle_marker">
      <static>true</static>
      <pose>6 6 1.25 0 0 0.4</pose>
      <link name="vehicle_link">
        <collision name="vehicle_collision">
          <geometry>
            <box>
              <size>2.5 1.3 1.0</size>
            </box>
          </geometry>
        </collision>
        <visual name="vehicle_visual">
          <geometry>
            <box>
              <size>2.5 1.3 1.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.2 0.7 1</ambient>
            <diffuse>0.2 0.25 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="person_marker">
      <static>true</static>
      <pose>-4 4 0.85 0 0 0</pose>
      <link name="person_link">
        <collision name="person_collision">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="person_visual">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>1.7</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.75 0.2 0.2 1</ambient>
            <diffuse>0.85 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="xray_uav">
      <static>false</static>
      <pose>12 0 8 0 0 3.14159</pose>

      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/xray/gz/cmd_vel</topic>
      </plugin>

      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <dimensions>3</dimensions>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/xray/gz/odometry</odom_topic>
        <odom_frame>map</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>

      <link name="base_link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.04</ixx>
            <iyy>0.04</iyy>
            <izz>0.08</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="body_collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.18</size>
            </box>
          </geometry>
        </collision>

        <visual name="body_visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.18</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.12 1</ambient>
            <diffuse>0.12 0.12 0.16 1</diffuse>
          </material>
        </visual>

        <visual name="arm_x_pos">
          <pose>0.45 0 0 0 0 1.5708</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>

        <visual name="arm_y_pos">
          <pose>0 0.45 0 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
